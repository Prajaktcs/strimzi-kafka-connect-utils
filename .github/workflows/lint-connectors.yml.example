# Example GitHub Actions workflow for linting connector configurations
# Copy this to .github/workflows/lint-connectors.yml to enable

name: Lint Connector Configurations

on:
  pull_request:
    paths:
      - 'connectors/**/*.yaml'
      - 'connectors/**/*.yml'
      - 'connectors/**/*.json'
  push:
    branches:
      - main
    paths:
      - 'connectors/**/*.yaml'
      - 'connectors/**/*.yml'
      - 'connectors/**/*.json'

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Lint connector configurations
        run: |
          EXIT_CODE=0
          shopt -s nullglob
          for file in connectors/**/*.{yaml,yml,json}; do
            echo "Linting $file..."
            cargo run -q -p strimzi-ops --bin strimzi-lint -- lint --strict "$file" || EXIT_CODE=$?
          done
          exit $EXIT_CODE

      - name: Lint with JSON output (for reporting)
        if: always()
        run: |
          shopt -s nullglob
          for file in connectors/**/*.{yaml,yml,json}; do
            echo "Results for $file:"
            cargo run -q -p strimzi-ops --bin strimzi-lint -- lint --json "$file"
          done
