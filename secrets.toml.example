# Strimzi Ops Configuration
# Copy this file to secrets.toml and update with your actual values

[kafka]
# Host Kafka metadata must advertise addresses reachable from the host.
# This repo's single-broker development listener advertises 127.0.0.1:9092.
# Forward broker 0's local Service port 9094, NOT the plain bootstrap port 9092.
# Plaintext/unauthenticated; keep the forward loopback-only. See k8s/README.md.
bootstrap_servers = "127.0.0.1:9092"

# Kafka Connect REST API URL
# For this repo's loopback-only Kubernetes port-forward: http://127.0.0.1:8083
# Production Connect endpoints require a separately secured deployment.
connect_url = "http://127.0.0.1:8083"

# Optional per-worker Prometheus exporter targets. Relative to this secrets file.
# just setup provisions metrics TLS; port-forward-all syncs CA and pod membership.
# Every worker URL MUST use HTTPS, including unauthenticated localhost exporters.
# Target entries accept optional bearer_token and ca_file (PEM CA path relative to
# the targets file); absent ca_file uses public roots. Keep both TOML files private.
metrics_targets_file = ".local/connect-metrics.toml"

[storage]
# Storage configuration (optional - only needed for some connectors)
# This is typically used for Iceberg or other connectors that need object storage
type = "s3"

# For RustFS in this repo's k8s stack (port-forward): http://127.0.0.1:9000
# For AWS S3: https://s3.amazonaws.com
endpoint_url = "http://127.0.0.1:9000"

# LOCAL DEV ONLY — match k8s/04-rustfs.yaml defaults; never use in production
access_key = "rustfsadmin"
secret_key = "rustfsadmin"
bucket = "warehouse"

# ============================================================================
# Kubernetes Setup Instructions
# ============================================================================
#
# Local development forwarding (single Kafka broker 0 only)
# --------------------------------------------------------
# Apply k8s/02-kafka.yaml and wait for operator reconciliation first; this may
# roll the broker but preserves PVCs, connector configs, groups and offsets.
#   kubectl apply -f k8s/02-kafka.yaml
#   kubectl wait kafka/my-cluster -n kafka --for=condition=Ready --timeout=300s
#
# Prefer tracked forwards (also starts per-worker HTTPS metrics forwards):
#   just sync-secrets
#   just port-forward-all
#   just status-forwards
#   just doctor
#   just stop-forwards
# sync-secrets overwrites secrets.toml with LOCAL DEV ONLY settings.
#
# Or run these foreground forwards in separate terminals:
#   kubectl port-forward --address 127.0.0.1 -n kafka svc/my-connect-cluster-connect-api 8083:8083
#   kubectl port-forward --address 127.0.0.1 -n kafka svc/my-cluster-kafka-local-0 9092:9094
#
# Do not forward my-cluster-kafka-bootstrap:9092 for host Kafka clients:
# its metadata advertises internal DNS names even if the TCP forward connects.
# Internal Connect clients continue using my-cluster-kafka-bootstrap:9092.
# No public NodePort/LoadBalancer is created. Loopback binding is not Kafka
# authentication: other local processes and cluster workloads can access this
# plaintext listener. Production networking/authentication is out of scope.
# See k8s/README.md for rollout/rollback and lag/backlog smoke instructions.
