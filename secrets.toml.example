# Strimzi Ops Configuration
# Copy this file to secrets.toml and update with your actual values

[kafka]
# Kafka bootstrap servers
# For Kubernetes with port-forward: localhost:9092
# For Kubernetes with LoadBalancer/NodePort: <external-ip>:<port>
# For Kubernetes with Ingress: kafka.example.com:9092
bootstrap_servers = "localhost:9092"

# Kafka Connect REST API URL
# For Kubernetes with port-forward: http://localhost:8083
# For Kubernetes with LoadBalancer/NodePort: http://<external-ip>:<port>
# For Kubernetes with Ingress: https://connect.example.com
connect_url = "http://localhost:8083"

# Optional Strimzi KafkaConnect resource name (also used as the UI cluster id
# when you are not using [[clusters]] below).
connect_cluster_name = "my-connect-cluster"

# Multiple Connect clusters in the UI: replace [kafka] with this instead.
# The UI is then scoped under /c/<id>/dashboard (and Control / Monitor).
#
# [[clusters]]
# id = "local"
# connect_url = "http://127.0.0.1:8083"
# bootstrap_servers = "127.0.0.1:9092"
# connect_cluster_name = "my-connect-cluster"
#
# [[clusters]]
# id = "prod"
# connect_url = "https://connect.example.com"
# bootstrap_servers = "kafka.example.com:9092"
# connect_cluster_name = "prod-connect"

# Many Kafka Connect clusters: do not maintain this file as a registry.
# Discover Strimzi KafkaConnect CRs instead:
#   cargo run -p strimzi-ui -- --from-k8s
#   cargo run -p strimzi-ops -- --from-k8s --cluster kafka_my-connect-cluster connectors list
#
# --cluster selects the loaded cluster ID (discovered IDs are <namespace>_<name>).
# --cluster-name independently overrides the exported strimzi.io/cluster label:
#   cargo run -p strimzi-ops -- --from-k8s --cluster kafka_my-connect-cluster connectors export-yaml orders --cluster-name export-connect
# In-cluster REST URL is http://<name>-connect-api.<ns>.svc:8083
# For a laptop UI, annotate the CR:
#   strimzi-ops.io/connect-url: http://127.0.0.1:8083

[storage]
# Storage configuration (optional - only needed for some connectors)
# This is typically used for Iceberg or other connectors that need object storage
type = "s3"

# For Garage in this repo's k8s stack (port-forward): http://localhost:3900
# For AWS S3: https://s3.amazonaws.com
endpoint_url = "http://localhost:3900"

# S3 credentials — match k8s/04-garage.yaml local-dev defaults
access_key = "GKaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
secret_key = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
bucket = "warehouse"

# ============================================================================
# Kubernetes Setup Instructions
# ============================================================================
#
# Option 1: Port Forwarding (Recommended for development)
# --------------------------------------------------------
# Forward Kafka Connect to localhost:
#   kubectl port-forward svc/my-connect-cluster-connect-api 8083:8083
#
# Forward Kafka broker to localhost (if needed):
#   kubectl port-forward svc/my-kafka-cluster-kafka-bootstrap 9092:9092
#
# Then use localhost URLs in this config file
#
#
# Option 2: LoadBalancer/NodePort
# --------------------------------
# If you've exposed services with LoadBalancer or NodePort, use the external IP/port
# Get the external endpoint:
#   kubectl get svc my-connect-cluster-connect-api
#
#
# Option 3: Ingress
# -----------------
# If you've set up Ingress for Kafka Connect, use the ingress hostname
# Example: https://kafka-connect.example.com
#
